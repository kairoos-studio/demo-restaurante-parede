---
import { Image } from 'astro:assets';
import { galeria } from '../config/imagens';
---

<section class="seccao galeria" id="galeria" aria-labelledby="galeria-titulo">
  <div class="contentor">
    <p class="sobretitulo">Galeria</p>
    <h2 id="galeria-titulo">Para abrir o apetite.</h2>
  </div>

  <ul class="galeria__fita" aria-label="Fotos de pratos">
    {
      galeria.map((foto, i) => (
        <li class={`galeria__item galeria__item--${i + 1}`}>
          <Image src={foto.src} alt={foto.alt} widths={[400, 640, 960]} sizes="(min-width: 860px) 33vw, 78vw" quality={70} />
        </li>
      ))
    }
  </ul>

  <p class="contentor galeria__nota">Fotos ilustrativas de bancos de imagens livres. Não são do restaurante.</p>
</section>

<style>
  .galeria {
    background: var(--creme);
  }

  .galeria__fita {
    list-style: none;
    margin: 2.25rem 0 0;
    padding: 0 var(--pad) 0.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    gap: 0.9rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--pad);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .galeria__fita::-webkit-scrollbar {
    display: none;
  }

  .galeria__item {
    scroll-snap-align: start;
    border-radius: var(--raio);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--tinta-2);
  }

  .galeria__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .galeria__item:hover img {
    transform: scale(1.04);
  }

  .galeria__nota {
    margin-top: 1rem;
    font-size: 0.82rem;
    color: var(--cinza);
  }

  @media (min-width: 860px) {
    .galeria__fita {
      width: min(100% - 2 * var(--pad), var(--max));
      margin-inline: auto;
      padding: 0;
      overflow: visible;
      grid-auto-flow: row;
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 14rem;
      gap: 1rem;
    }

    .galeria__item {
      aspect-ratio: auto;
    }

    .galeria__item--1 {
      grid-row: span 2;
      grid-column: span 2;
    }
  }
</style>
