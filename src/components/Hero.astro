---
import { Image } from 'astro:assets';
import { restaurante } from '../config/restaurante';
import { fotos } from '../config/imagens';

const [primeiro, ...resto] = restaurante.nome.split(' ');
const chips = ['Esplanada', 'Take away', 'Entrega', 'Estacionamento gratuito'];
---

<header class="hero" id="topo">
  <Image
    class="hero__foto"
    src={fotos.moquecaCamarao.src}
    alt={fotos.moquecaCamarao.alt}
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    quality={72}
  />
  <div class="hero__veu" aria-hidden="true"></div>

  <nav class="topo contentor" aria-label="Principal">
    <a class="topo__marca" href="#topo">{restaurante.nome}</a>
    <ul class="topo__links">
      <li><a href="#menu">Menu</a></li>
      <li><a href="#horario">Horário</a></li>
      <li><a href="#galeria">Galeria</a></li>
      <li><a href="#sobre">Sobre</a></li>
      <li><a href="#onde">Onde estamos</a></li>
    </ul>
    <a class="topo__reservar" href="#reservar">Reservar</a>
  </nav>

  <div class="hero__conteudo contentor">
    <p class="hero__tipo">{restaurante.tipo}</p>
    <h1 class="hero__nome">
      <span>{primeiro}</span>
      <em>{resto.join(' ')}</em>
    </h1>
    <p class="hero__mote">
      <span aria-hidden="true" class="hero__traco"></span>
      {restaurante.mote}
    </p>
    <div class="hero__acoes">
      <a class="botao botao--principal" href="#reservar">Reservar mesa</a>
      <a class="botao botao--contorno" href="#menu">Ver o menu</a>
    </div>
    <ul class="hero__chips" aria-label="Serviços">
      {chips.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</header>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    min-height: calc(100svh - 2rem);
    display: grid;
    grid-template-rows: auto 1fr;
    color: var(--papel);
    background: var(--tinta);
    overflow: hidden;
  }

  .hero__foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 45% 50%;
    z-index: -2;
    animation: aproximar 14s ease-out both;
  }

  @keyframes aproximar {
    from {
      transform: scale(1.12);
    }
    to {
      transform: scale(1);
    }
  }

  .hero__veu {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(28 20 17 / 0.6) 0%, rgb(28 20 17 / 0.05) 22%, rgb(28 20 17 / 0.7) 42%, rgb(28 20 17 / 0.95) 68%),
      radial-gradient(120% 70% at 0% 100%, rgb(196 70 42 / 0.45), transparent 60%);
  }

  .topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.1rem;
  }

  .topo__marca {
    font-family: var(--f-titulo);
    font-weight: 700;
    font-style: italic;
    font-size: 1.2rem;
    text-decoration: none;
    font-variation-settings: 'SOFT' 100, 'WONK' 0;
  }

  .topo__links {
    display: none;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.75rem;
    font-size: 0.95rem;
  }

  .topo__links a {
    text-decoration: none;
    opacity: 0.85;
  }

  .topo__links a:hover {
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }

  .topo__reservar {
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: rgb(255 250 242 / 0.14);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow: inset 0 0 0 1px rgb(255 250 242 / 0.3);
  }

  .hero__conteudo {
    align-self: end;
    padding-bottom: clamp(2rem, 7vh, 4.5rem);
  }

  .hero__tipo {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--creme);
    opacity: 0.9;
  }

  .hero__nome {
    margin-top: 0.6rem;
    font-size: clamp(4.2rem, 22vw, 9.5rem);
    line-height: 0.86;
    letter-spacing: -0.045em;
    font-weight: 800;
    font-variation-settings: 'SOFT' 100, 'WONK' 1, 'opsz' 144;
    text-shadow: 0 2px 30px rgb(28 20 17 / 0.45);
  }

  .hero__nome span,
  .hero__nome em {
    display: block;
  }

  .hero__nome em {
    color: var(--mostarda);
    font-weight: 600;
    margin-left: 0.04em;
  }

  .hero__mote {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.1rem;
    font-family: var(--f-titulo);
    font-style: italic;
    font-size: clamp(1.25rem, 5vw, 1.8rem);
    font-weight: 450;
    font-variation-settings: 'SOFT' 100, 'WONK' 0;
  }

  .hero__traco {
    width: 2.25rem;
    height: 2px;
    background: var(--mostarda);
  }

  .hero__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .hero__acoes .botao {
    flex: 1 1 10rem;
  }

  .hero__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    font-size: 0.82rem;
    color: var(--creme);
    opacity: 0.85;
  }

  .hero__chips li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero__chips li::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--mostarda);
  }

  @media (min-width: 860px) {
    .topo__links {
      display: flex;
    }

    .hero__conteudo {
      max-width: var(--max);
    }

    .hero__acoes .botao {
      flex: 0 0 auto;
      padding-inline: 2rem;
    }

    .hero__veu {
      background:
        linear-gradient(90deg, rgb(28 20 17 / 0.92) 0%, rgb(28 20 17 / 0.6) 45%, rgb(28 20 17 / 0.1) 75%),
        linear-gradient(180deg, rgb(28 20 17 / 0.5) 0%, transparent 25%);
    }

    .hero__foto {
      object-position: 50% 60%;
    }
  }
</style>
